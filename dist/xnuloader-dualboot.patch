+/* ------------------------------------------------------------------------ */
+/* Dual-boot selection: one flag block, then either this kernel or Android  */
+
+struct boot_flag {
+	uint32_t magic;      /* FLAG_MAGIC when the block has been provisioned */
+	uint32_t state;      /* FLAG_STATE_IOS: boot iOS once, then fall back to Android */
+	uint32_t fb_bytes;   /* size of flashboot.apfs at FLASHBOOT_LBA */
+	uint32_t reserved;
+};
+
+static int
+boot_flag_read(struct boot_flag *f)
+{
+	efi_block_io *bio = find_named_partition(FLAG_PARTITION);
+
+	if (bio == NULL || bio->media->block_size != 4096) {
+		return 0;
+	}
+	if (EFI_ERROR(bio->read_blocks(bio, bio->media->media_id, FLAG_LBA, 1, block_buffer))) {
+		return 0;
+	}
+	memcpy(f, block_buffer, sizeof(*f));
+	return f->magic == FLAG_MAGIC;
+}
+
+static void
+boot_flag_write_state(uint32_t state)
+{
+	efi_block_io *bio = find_named_partition(FLAG_PARTITION);
+	struct boot_flag *f = (struct boot_flag *)block_buffer;
+
+	if (bio == NULL || bio->media->block_size != 4096) {
+		return;
+	}
+	if (EFI_ERROR(bio->read_blocks(bio, bio->media->media_id, FLAG_LBA, 1, block_buffer))) {
+		return;
+	}
+	f->state = state;
+	clean_dcache((uint64_t)(uintptr_t)block_buffer, (uint64_t)(uintptr_t)block_buffer + 4096);
+	if (!EFI_ERROR(bio->write_blocks(bio, bio->media->media_id, FLAG_LBA, 1, block_buffer))) {
+		bio->flush_blocks(bio);
+	}
+}
+
+/* The image BootShim hands off to: the flag at 0x17FE00000 plus a warm reset. */
+static void
+android_handoff(void)
+{
+	volatile uint16_t *p = (volatile uint16_t *)(uintptr_t)ANDROID_FLAG_ADDR;
+
+	for (int i = 0; i < 128; i++) {
+		p[i] = ANDROID_FLAG_VALUE;
+	}
+	clean_dcache(ANDROID_FLAG_ADDR, ANDROID_FLAG_ADDR + 256);
+	print("dualboot: Android\n");
+	ST->rt->reset_system(1 /* EfiResetWarm */, 0, 0, NULL);
+	for (;;) {
+	}
+}
+
+static int
+flashboot_ok(const struct boot_flag *f)
+{
+	efi_block_io *bio = find_named_partition(FLAG_PARTITION);
+
+	if (bio == NULL || f->fb_bytes == 0 || (f->fb_bytes & 4095) != 0 || f->fb_bytes > BLOCK_BUFFER_SIZE) {
+		return 0;
+	}
+	if (EFI_ERROR(bio->read_blocks(bio, bio->media->media_id, FLASHBOOT_LBA, 1, block_buffer))) {
+		return 0;
+	}
+	return memcmp(block_buffer + 32, "NXSB", 4) == 0;
+}
+
+/* Copy flashboot.apfs into the resident slot the kernel takes as its root. */
+static uint64_t
+load_flashboot(uint8_t *dest, uint64_t limit)
+{
+	struct boot_flag f;
+	efi_block_io *bio;
+	uint64_t count;
+
+	if (!boot_flag_read(&f) || !flashboot_ok(&f) || f.fb_bytes > limit) {
+		return 0;
+	}
+	bio = find_named_partition(FLAG_PARTITION);
+	count = f.fb_bytes / 4096;
+	if (EFI_ERROR(bio->read_blocks(bio, bio->media->media_id, FLASHBOOT_LBA, count, block_buffer))) {
+		return 0;
+	}
+	memcpy(dest, block_buffer, f.fb_bytes);
+	return f.fb_bytes;
+}
