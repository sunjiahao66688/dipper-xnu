+/* ------------------------------------------------------------------------ */
+/* Timer probe (EXP-0028): which interrupt does the EL1 virtual timer raise?   */
+/*                                                                          */
+/* The kernel hard-codes PPI 27 (INTID); Qualcomm parts up to SDM845 wire the  */
+/* timers to INTID 16-19 (stock DT of the Mi 8: virtual 19). This starts the   */
+/* virtual timer for 1 ms with interrupts masked on this core, and reads which */
+/* PPI of this core's redistributor goes pending. It writes no GIC register.   */
+
+static uint32_t
+mmio_r32(uint64_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+/*
+ * "idprobe" (EXP-0043, U-032): which of the 8 cores can run what the kernel needs? Each core is started
+ * by the firmware (PSCI CPU_ON, as for "bootcpu=N") at id_probe_entry, which reads the core's ID registers
+ * into its own line of id_probe_out[], marks it done and switches itself off. No kernel runs, nothing is
+ * written anywhere but into these lines. Registers (ARM ARM): MIDR_EL1, MPIDR_EL1, ID_AA64PFR0_EL1,
+ * ID_AA64MMFR0_EL1 (TGran16 [23:20]: 0 no 16 KB pages, 1 yes), ID_AA64MMFR1_EL1, ID_AA64ISAR0_EL1,
+ * ID_AA64ISAR1_EL1 (APA [7:4], API [11:8]: address authentication; GPA [27:24], GPI [31:28]: generic).
+ */
+struct id_probe_line {
+	volatile uint64_t done;         /* written last */
+	uint64_t el, midr, mpidr, pfr0, mmfr0, mmfr1, isar0, isar1;
+	uint64_t cycles, ticks;     /* PMCCNTR_EL0 and CNTVCT_EL0 over the same ~20 ms: the core's actual clock (EXP-0049) */
+} __attribute__((aligned(128)));
+static struct id_probe_line id_probe_out[8];
+void id_probe_entry(void);
+
+__asm__ (
+        ".text\n"
+        ".balign 64\n"
+        ".globl id_probe_entry\n"
+        "id_probe_entry:\n"                     /* x0 = this core's line; MMU and caches are off */
+        "  msr daifset, #0xf\n"
+        /* a register this core may not touch must not send it nowhere: other_cpu_fault switches the core off */
+        "  adrp x9, other_cpu_vectors\n"
+        "  add  x9, x9, :lo12:other_cpu_vectors\n"
+        "  msr vbar_el1, x9\n"
+        "  isb\n"
+        "  mrs x9, CurrentEL\n"
+        "  lsr x9, x9, #2\n"
+        "  str x9, [x0, #8]\n"
+        "  mrs x9, midr_el1\n"
+        "  str x9, [x0, #16]\n"
+        "  mrs x9, mpidr_el1\n"
+        "  str x9, [x0, #24]\n"
+        "  mrs x9, id_aa64pfr0_el1\n"
+        "  str x9, [x0, #32]\n"
+        "  mrs x9, id_aa64mmfr0_el1\n"
+        "  str x9, [x0, #40]\n"
+        "  mrs x9, id_aa64mmfr1_el1\n"
+        "  str x9, [x0, #48]\n"
+        "  mrs x9, id_aa64isar0_el1\n"
+        "  str x9, [x0, #56]\n"
+        "  mrs x9, id_aa64isar1_el1\n"
+        "  str x9, [x0, #64]\n"
+        /* the clock: count cycles (PMCCNTR_EL0: PMCR_EL0.E and .C, PMCNTENSET_EL0 bit 31) for 1/50 s of CNTVCT */
+        "  mov x9, #5\n"
+        "  msr pmcr_el0, x9\n"
+        "  mov x9, #1\n"
+        "  lsl x9, x9, #31\n"
+        "  msr pmcntenset_el0, x9\n"
+        "  isb\n"
+        "  mrs x12, cntfrq_el0\n"
+        "  mov x13, #50\n"
+        "  udiv x12, x12, x13\n"
+        "  mrs x10, cntvct_el0\n"
+        "  mrs x11, pmccntr_el0\n"
+        "  add x12, x12, x10\n"
+        "3: mrs x14, cntvct_el0\n"
+        "  cmp x14, x12\n"
+        "  b.lo 3b\n"
+        "  mrs x15, pmccntr_el0\n"
+        "  mrs x16, cntvct_el0\n"
+        "  sub x15, x15, x11\n"
+        "  sub x16, x16, x10\n"
+        "  str x15, [x0, #72]\n"
+        "  str x16, [x0, #80]\n"
+        "  dsb sy\n"
+        "  mov x9, #1\n"
+        "  str x9, [x0]\n"
+        "  dsb sy\n"
+        "  sev\n"
+        "  adrp x10, psci_by_hvc\n"
+        "  add  x10, x10, :lo12:psci_by_hvc\n"
+        "  ldr x9, [x10]\n"
+        "  mov x0, #0x0002\n"                   /* PSCI CPU_OFF: does not return */
+        "  movk x0, #0x8400, lsl #16\n"
+        "  cbnz x9, 2f\n"
+        "  smc #0\n"
+        "1: wfi\n"
+        "  b 1b\n"
+        "2: hvc #0\n"
+        "  b 1b\n"
+        );
+
+static void
+id_probe(void)
+{
+	uint64_t self = READ_SYSREG(MPIDR_EL1) & 0xFFFFFF;
+
+	psci_by_hvc = PLAT->psci_hvc;
+	clean_dcache((uint64_t)(uintptr_t)&psci_by_hvc, (uint64_t)(uintptr_t)&psci_by_hvc + 8);
+	clean_dcache((uint64_t)(uintptr_t)&id_probe_entry, (uint64_t)(uintptr_t)&id_probe_entry + 0x200);
+	print("idprobe: core 0 is %x; the others are started one at a time\n", self);
+	/* this core last: its PMU access is the one that could go wrong on this core's own stack of handlers */
+	for (int k = 0; k < PLAT->cores && k < 8; k++) {
+		int core = (k + 1) % PLAT->cores;
+		uint64_t mpidr = (uint64_t)core << PLAT->core_shift;
+		struct id_probe_line *l = &id_probe_out[core];
+		int64_t status = 0;
+		uint64_t t;
+
+		if (mpidr == self) {
+			uint64_t m = READ_SYSREG(MPIDR_EL1);
+			__asm__ volatile ("mrs %0, id_aa64pfr0_el1" : "=r" (l->pfr0));
+			__asm__ volatile ("mrs %0, id_aa64mmfr0_el1" : "=r" (l->mmfr0));
+			__asm__ volatile ("mrs %0, id_aa64mmfr1_el1" : "=r" (l->mmfr1));
+			__asm__ volatile ("mrs %0, id_aa64isar0_el1" : "=r" (l->isar0));
+			__asm__ volatile ("mrs %0, id_aa64isar1_el1" : "=r" (l->isar1));
+			l->midr = READ_SYSREG(MIDR_EL1);
+			l->mpidr = m;
+			l->el = 1;
+			{
+				uint64_t c0, c1, t0, t1, want = READ_SYSREG(CNTFRQ_EL0) / 50;
+
+				__asm__ volatile ("msr pmcr_el0, %0\n msr pmcntenset_el0, %1\n isb" : : "r" (5ULL), "r" (1ULL << 31));
+				t0 = READ_SYSREG(CNTVCT_EL0);
+				__asm__ volatile ("mrs %0, pmccntr_el0" : "=r" (c0));
+				while (READ_SYSREG(CNTVCT_EL0) - t0 < want) {
+				}
+				__asm__ volatile ("mrs %0, pmccntr_el0" : "=r" (c1));
+				t1 = READ_SYSREG(CNTVCT_EL0);
+				l->cycles = c1 - c0;
+				l->ticks = t1 - t0;
+			}
+			l->done = 1;
+		} else {
+			memset(l, 0, sizeof(*l));
+			clean_dcache((uint64_t)(uintptr_t)l, (uint64_t)(uintptr_t)l + sizeof(*l));
+			status = psci_call(PSCI_CPU_ON, mpidr, (uint64_t)(uintptr_t)&id_probe_entry, (uint64_t)(uintptr_t)l);
+			t = READ_SYSREG(CNTVCT_EL0);
+			while (status == 0 && seconds_since(t) < 3) {
+				flush_dcache((uint64_t)(uintptr_t)l, (uint64_t)(uintptr_t)l + sizeof(*l));
+				if (l->done) {
+					break;
+				}
+			}
+			flush_dcache((uint64_t)(uintptr_t)l, (uint64_t)(uintptr_t)l + sizeof(*l));
+		}
+		if (!l->done) {
+			print("idprobe: core %d (mpidr %x): firmware says %d, no answer\n", (uint64_t)core, mpidr, (uint64_t)status);
+			continue;
+		}
+		print("idprobe: core %d mpidr %x EL%d MIDR %x part %x\n", (uint64_t)core, l->mpidr & 0xFFFFFF, l->el, l->midr,
+		    (l->midr >> 4) & 0xFFF);
+		print("  clock: %d cycles in %d ticks of %d Hz = %d MHz\n", l->cycles, l->ticks, READ_SYSREG(CNTFRQ_EL0),
+		    l->ticks ? l->cycles * (READ_SYSREG(CNTFRQ_EL0) / 1000) / l->ticks / 1000 : 0);
+		print("  MMFR0 %x TGran16 %d TGran4 %d TGran64 %d | ISAR0 %x ISAR1 %x APA %d API %d GPA %d GPI %d | PFR0 %x\n",
+		    l->mmfr0, (l->mmfr0 >> 20) & 0xF, (l->mmfr0 >> 28) & 0xF, (l->mmfr0 >> 24) & 0xF, l->isar0, l->isar1,
+		    (l->isar1 >> 4) & 0xF, (l->isar1 >> 8) & 0xF, (l->isar1 >> 24) & 0xF, (l->isar1 >> 28) & 0xF, l->pfr0);
+	}
+	print("idprobe: done\n");
+}
+
+static uint64_t
+mmio_r64(uint64_t a)
+{
+	return *(volatile uint64_t *)a;
+}
+
+static void
+timer_probe(void)
+{
+	uint64_t mpidr = READ_SYSREG(MPIDR_EL1), freq = READ_SYSREG(CNTFRQ_EL0);
+	uint64_t aff = (mpidr & 0xFFFFFF) | (((mpidr >> 32) & 0xFF) << 24);
+	uint64_t rd = 0;
+
+	print("tprobe: mpidr %x cntfrq %d\n", mpidr, freq);
+	for (unsigned i = 0; i < 16; i++) {
+		uint64_t frame = PLAT->gic_redist + (uint64_t)i * 0x20000;
+		uint64_t typer = mmio_r64(frame + 0x08);
+
+		print("tprobe: gicr[%d] at %x typer %x\n", (uint64_t)i, frame, typer);
+		if ((typer >> 32) == aff) {
+			rd = frame;
+			break;
+		}
+		if (typer & 0x10) {
+			break;
+		}
+	}
+	if (rd == 0) {
+		print("tprobe: no redistributor frame for this core\n");
+		return;
+	}
+
+	uint64_t sgi = rd + 0x10000;
+	uint64_t daif, ctl0, ctl1, pend0, pend1, pend2, enabled, t;
+
+	print("tprobe: rd %x waker %x\n", rd, (uint64_t)mmio_r32(rd + 0x14));
+	print("tprobe: igroupr0 %x grpmodr0 %x isenabler0 %x icfgr1 %x\n", (uint64_t)mmio_r32(sgi + 0x80),
+	    (uint64_t)mmio_r32(sgi + 0xD00), (uint64_t)mmio_r32(sgi + 0x100), (uint64_t)mmio_r32(sgi + 0xC04));
+
+	__asm__ volatile ("mrs %0, daif" : "=r" (daif));
+	__asm__ volatile ("msr daifset, #3" ::: "memory");
+	__asm__ volatile ("msr cntv_ctl_el0, %0; isb" :: "r" (0ULL) : "memory");
+	ctl0 = READ_SYSREG(CNTV_CTL_EL0);
+	pend0 = mmio_r32(sgi + 0x200);
+	__asm__ volatile ("msr cntv_tval_el0, %0" :: "r" (freq / 1000) : "memory");
+	__asm__ volatile ("msr cntv_ctl_el0, %0; isb" :: "r" (1ULL) : "memory");
+	t = READ_SYSREG(CNTVCT_EL0);
+	while (READ_SYSREG(CNTVCT_EL0) - t < freq / 200) {
+	}
+	ctl1 = READ_SYSREG(CNTV_CTL_EL0);
+	pend1 = mmio_r32(sgi + 0x200);
+	enabled = mmio_r32(sgi + 0x100);
+	__asm__ volatile ("msr cntv_ctl_el0, %0; isb" :: "r" (0ULL) : "memory");
+	pend2 = mmio_r32(sgi + 0x200);
+	__asm__ volatile ("msr daif, %0" :: "r" (daif) : "memory");
+
+	print("tprobe: CNTV_CTL before %x, after 5 ms %x (bit 2 = ISTATUS: the timer fired)\n", ctl0, ctl1);
+	print("tprobe: ISPENDR0 before %x, with timer %x, timer off %x; ISENABLER0 %x\n", pend0, pend1, pend2, enabled);
+	for (unsigned n = 16; n < 32; n++) {
+		if (((pend1 & ~pend0) >> n) & 1) {
+			print("tprobe: INTID %d went pending because of the virtual timer\n", (uint64_t)n);
+		}
+	}
+	if ((pend1 & ~pend0) == 0) {
+		print("tprobe: no PPI went pending (ISTATUS says %d)\n", (ctl1 >> 2) & 1);
+	}
+}
